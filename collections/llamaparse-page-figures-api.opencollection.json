{
  "opencollection": "1.0.0",
  "info": {
    "name": "Llama Platform Agent Data Page Figures API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Page Figures",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List File Pages Figures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/files/:id/page-figures",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List metadata for all figures from all pages of a file."
        },
        {
          "info": {
            "name": "List File Page Figures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/files/:id/page-figures/:page_index",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_index",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List metadata for figures from a specific page of a file."
        },
        {
          "info": {
            "name": "Get File Page Figure",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/files/:id/page-figures/:page_index/:figure_name",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_index",
                "value": "",
                "type": "path"
              },
              {
                "name": "figure_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a specific figure from a page of a file."
        },
        {
          "info": {
            "name": "Generate File Page Figure Presigned Url",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/files/:id/page-figures/:page_index/:figure_name/presigned_url",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_index",
                "value": "",
                "type": "path"
              },
              {
                "name": "figure_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a short-lived presigned URL to read a page figure; treat the URL as sensitive while it is valid."
        }
      ]
    }
  ],
  "bundled": true
}