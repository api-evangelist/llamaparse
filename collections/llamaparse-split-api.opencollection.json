{
  "opencollection": "1.0.0",
  "info": {
    "name": "Llama Platform Agent Data Split API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Split",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Split Jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/beta/split/jobs",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by job status (pending, processing, completed, failed, cancelled)"
              },
              {
                "name": "job_ids",
                "value": "",
                "type": "query",
                "description": "Filter by specific job IDs"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_at_on_or_after",
                "value": "",
                "type": "query",
                "description": "Include items created at or after this timestamp (inclusive)"
              },
              {
                "name": "created_at_on_or_before",
                "value": "",
                "type": "query",
                "description": "Include items created at or before this timestamp (inclusive)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List document split jobs."
        },
        {
          "info": {
            "name": "Create Split Job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/beta/split/jobs",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a document split job."
        },
        {
          "info": {
            "name": "Get Split Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/beta/split/jobs/:split_job_id",
            "params": [
              {
                "name": "split_job_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a document split job."
        }
      ]
    }
  ],
  "bundled": true
}