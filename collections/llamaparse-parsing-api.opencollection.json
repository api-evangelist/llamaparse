          "info": {
            "name": "Get Job Image Result",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parsing/job/:job_id/result/image/:name",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a job by id"
        },
        {
          "info": {
            "name": "Get Supported File Extensions",
